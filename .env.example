# ============ SERVER ============
PORT=3000
# Simple password to open the admin panel (change this!)
ADMIN_PASSWORD=change-me-please

# ============ LOCAL DEV SAFETY (leave both unset/true on the real server) ============
# If you run this app on a second machine (e.g. your laptop) while it's already deployed
# and connected on a server, DO NOT leave these enabled — Baileys would try to reconnect
# using the SAME linked WhatsApp account, which can force the real server session offline.
# Set WHATSAPP_ENABLED=false for any local run. SCHEDULER_ENABLED=false is recommended
# alongside it so cron jobs don't fire against real Google/Meta accounts locally either.
# WHATSAPP_ENABLED=false
# SCHEDULER_ENABLED=false

# ============ GOOGLE (Calendar + Meet + Drive + Gmail) ============
# Ek hi Google Cloud project banao, ye 4 APIs enable karo:
# Calendar API, Drive API, Gmail API, YouTube Data API v3
# Fir OAuth 2.0 Client (Desktop/Web) bana ke refresh token nikaalo (README dekho)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Jis Gmail se emails jaayenge (usually tumhara/Arya ka)
GOOGLE_SENDER_EMAIL=

# Drive folder jahan tum class recordings daaloge (naming: BatchName_Topic_Date.mp4)
DRIVE_INBOX_FOLDER_ID=
# Drive folder jaha social post ke liye videos padi hain
DRIVE_POST_QUEUE_FOLDER_ID=
# Drive folder jahan posted videos move ho jaayengi
DRIVE_POSTED_FOLDER_ID=

# ============ GEMINI (captions/hashtags + lead responder) ============
GEMINI_API_KEY=

# Lead-responder models. Pinned explicitly on purpose (not a "-latest" alias) — Google
# retires dated models and rotates what "-latest" points to, sometimes onto a brand-new
# release with a very small free-tier quota. If one of these stops working, check what's
# actually available/working for your key before picking a replacement.
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
# Fallback default only for callers that don't use the tier router (chat:test, follow-ups).
GEMINI_REPLY_MODEL=gemini-3.5-flash

# Priority-based model routing for lead replies (deterministic rules decide the tier,
# never an LLM call). Tier 1 = payment intent/objections/hot leads — anything the hard
# rule protects, since real bank/UPI details never come from a lower tier. Tier 2 =
# normal Q&A. Tier 3 = greetings/small talk, and Tier 2's fallback on quota exhaustion.
GEMINI_TIER1_MODEL=gemini-3.5-flash
GEMINI_TIER2_MODEL=gemini-3.5-flash-lite
GEMINI_TIER3_MODEL=gemini-3.1-flash-lite

# Second WhatsApp number for hot-lead alerts + weekly digests — full number, country
# code, no + or spaces (e.g. 91XXXXXXXXXX). Leave blank to disable alerts entirely.
OPERATOR_ALERT_NUMBER=

# Backlog Scan: skip reopening any chat whose last message is older than this many days.
BACKLOG_MAX_AGE_DAYS=60

# Drive folder invoice PDFs get backed up to (best-effort — invoice generation/WhatsApp
# delivery still works fine if this is blank or Google isn't configured at all).
DRIVE_INVOICES_FOLDER_ID=

# ============ META (Facebook Page + Instagram) ============
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# ============ YOUTUBE ============
# YouTube usi Google OAuth se chalta hai (upar wala refresh token).
# Bas channel us Google account ka hona chahiye.

# ============ WHATSAPP ============
# Baileys session first run pe QR terminal me dikhayega — phone se scan karna.
# Group me direct bhejne ke liye group JID (README me nikalne ka tarika)
WHATSAPP_DEFAULT_GROUP_JID=
